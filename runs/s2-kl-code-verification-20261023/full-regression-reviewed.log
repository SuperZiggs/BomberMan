.open("rb") as handle:\n        for chunk in iter(lambda: handle.read(1024 * 1024), b""):\n            data.update(chunk)\n    return data.hexdigest()\n\n\ndef requirepaths(paths):\n    missing = [str(path) for path in paths if not path.isfile()]\n    if missing:\n        raise FileNotFoundError("Frozen PDE checkpoint missing: " + ", ".join(missing))\n    changed = [str(path) for path in paths if digest(path) != FROZENCHECKPOINTS[path]]\n    if changed:\n        raise ValueError("Frozen PDE checkpoint digest mismatch: " + ", ".join(changed))\n\n\ndef validaterecoveryresume(output: Path):\n    """Permit only the audited no-game recovery exception for an opened PDE seed."""\n    registrationpath, markerpath = output / "registration.json", output / "testopened.json"\n    if not registrationpath.isfile() or not markerpath.isfile():\n        raise ValueError("recovery requires registered seed metadata")\n    registration = json.loads(registrationpath.readtext(encoding="utf-8"))\n    marker = json.loads(markerpath.readtext(encoding="utf-8"))\n    if registration.get("seed") != NORMALSEED or registration.get("smoke") or marker.get("seed") != NORMALSEED:\n        raise ValueError("recovery seed metadata mismatch")\n    prohibited = ("report.json", "raw-records.json", "records.json", "shards")\n    if any((output / name).exists() for name in prohibited):\n        raise ValueError("recovery is allowed only for an audited no-game output")\n    return registration\n\n\ndef validateresume(output: Path, *, smoke: bool):\n    """Validate an interrupted run before reading any of its board shards."""\n    registrationpath = output / "registration.json"\n    if not registrationpath.isfile():\n        raise ValueError("resume requires registered experiment metadata")\n    if (output / "report.json").exists():\n        raise ValueError("resume refuses an output that already has report.json")\n    registration = json.loads(registrationpath.readtext(encoding="utf-8"))\n    if bool(regist