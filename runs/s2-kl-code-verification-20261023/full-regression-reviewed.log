oardsize, agents, boards, maxsteps):\n    legacy = LEGACYEPATHS[agents]\n    cachekey = ("E", boardsize, agents)\n    if cachekey not in POLICYCACHE:\n        POLICYCACHE[cachekey] = policyset(boardsize, {"legacyE": legacy, "G": GPATH, "Gsearch3": GPATH})\n    policies = POLICYCACHE[cachekey]\n    allrows = []\n    for arm in ("RB", "legacyE", "G", "Gsearch3"):\n        if arm == "RB":\n            policies[arm] = policies["RB"]\n        for board in boards:\n            for rotation in range(agents):\n                seats = seatassignment((arm, *(f"RB{i}" for i in range(1, agents))), rotation)\n                current = {seat: policies["RB"] for seat in seats if seat.startswith("RB")}\n                current[arm] = policies[arm]\n                rows = runseededgame(board=board, boardsize=boardsize, seatagents=seats,\n                                       policies=current, maxsteps=maxsteps, rotation=rotation,\n                                       context=context, extra={"opponent": "RuleBot"})\n                allrows.extend(row for row in rows if row["agent"] == arm)\n    return allrows\n\n\ndef drows(boards, maxsteps):\n    if "D" not in POLICYCACHE:\n        paths = {"G": GPATH, "Gsearch3": GPATH, "F": FPATH, "S": SPATH, "B": BPATH,\n                 "legacyD": LEGACYDPATH}\n        POLICYCACHE["D"] = policyset(9, paths)\n    policies = POLICYCACHE["D"]\n    allrows = []\n    for opponent in ("G", "F", "S", "B", "legacyD"):\n        for learner in ("G", "Gsearch3"):\n            learnerkey, opponentkey = f"learner{learner}", f"opponent{opponent}"\n            local = {learnerkey: policies[learner], opponentkey: policies[opponent]}\n            for board in boards:\n                for rotation in range(2):\n                    seats = seatassignment((learnerkey, opponentkey), rotation)\n                    rows = runseededgame(board=board, boardsize=9, seatagents=seats,\n                                           policies=local, maxsteps=maxsteps, rotation=rotation,\n                                           context="D", extra={"opponent": opponent, "arm": learner})\n                    for row in rows:\n                        if row["agent"] == learnerkey:\n                            row["agent"] = learner\n                            allrows.append(row)\n    return allrows\n\n\ndef pdechunk(job):\n    if job["kind"] == "E":\n        return erows(job["context"], job["boardsize"], job["agents"], job["boards"], job["maxsteps"])\n    if job["kind"] == "D":\n        return drows(job["boards"], job["maxsteps"])\n    raise ValueError(f"Unknown PDE chunk: {job[\'kind\']}")\n\n\ndef splitboards(boards, workers):\n    return [[board] for board in boards]\n\n\ndef makejobs(seed, e2count, e1count, dcount, maxsteps):\n    """One job is one durable board shard and contains all required rotations."""\n    jobs = []\n    for board in range(seed, seed + e2count):\n        jobs.append({"id": f"E2-{board}", "kind": "E", "context": "E2", "boardsize": 11,\n                     "agents": 4, "boards": [board], "maxsteps": maxsteps})\n    for board in range(seed + 1000, seed + 1000 + e1count):\n        jobs.append({"id": f"E1-{board}", "kind": "E", "context": "E1", "boardsize": 9,\n                     "agents": 3, "boards": [board], "maxsteps": maxsteps})\n    for board in range(seed + 2000, seed + 2000 + dcount):\n        jobs.append({"id": f"D-{board}", "kind": "D", "context": "D", "boards": [board],\n                     "maxsteps": maxsteps})\n    return jobs\n\n\ndef expectedpderecords(job):\n    """Return the immutable identity tuple for every learner record in a shard."""\n    board = job["boards"][0]\n    if job["kind"] == "E":\n        expected = []\n        for arm in ("RB", "legacyE", "G", "Gsearch3"):\n            for rotation in range(job["agents"]):\n                seats = seatassignment((arm, *(f"RB{index}" for index in range(1, job["agents"]))), rotation)\n                expected.append((board, job["context"], arm, rotation, seats.index(arm), "RuleBot"))\n        return expected\n    if job["kind"] == "D":\n        expected = []\n        for opponent in ("G", "F", "S", "B", "legacyD"):\n            for learner in ("G", "Gsearch3"):\n                learnerkey, opponentkey = f"learner{learner}", f"opponent{opponent}"\n                for rotation in range(2):\n                    seats = seatassignment((learnerkey, opponentkey), rotation)\n                    expected.append((board, "D", learner, rotation, seats.index(learnerkey), opponent))\n        return expected\n    raise ValueError(f"Unknown PDE shard kind: {job[\'kind\']}")\n\n\ndef validatepdeshard(job, payload):\n    """Reject stale, partial, or tampered board shards before they affect a report."""\n    if payload.get("metadata") != job or not isinstance(payload.get("records"), list):\n        raise ValueError(f"incomplete shard metadata for {job[\'id\']}")\n    required = {"board", "context", "agent", "rotation", "corner", "opponent", "steps",\n                "win", "activewin", "draw", "passivewin", "suicide", "suddendeathdeath",\n                "kills", "bombs"}\n    rows = payload["records"]\n    if any(not required.issubset(row) for row in rows):\n        raise ValueError(f"incomplete shard record for {job[\'id\']}")\n    actual = [(row["board"], row["context"], row["agent"], row["rotation"], row["corner"], row["opponent"])\n              for row in rows]\n    if sorted(actual) != sorted(expectedpderecords(job)):\n        raise ValueError(f"shard alignment mismatch for {job[\'id\']}")\n    if any(float(row["steps"]) > job["maxsteps"] for row in rows):\n        raise ValueError(f"shard step limit mismatch for {job[\'id\']}")\n    return rows\n\n\ndef writeshard(path: Path, job, rows):\n    """Durably publish a complete shard; a crash cannot expose a partial JSON file."""\n    path.parent.mkdir(parents=True, existok=True)\n    payload = {"metadata": job, "records": rows}\n    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as handle:\n        json.dump(payload, handle)\n        temporary = handle.name\n    try:\n        os.replace(temporary, path)\n    finally:\n        if os.path.exists(temporary):\n            os.unlink(temporary)\n\n\ndef runshards(output: Path, jobs, workers):\n    """Reuse only validated board shards, persist each new board before logging it."""\n    sharddir = output / "shards"\n    existing, missing = {}, []\n    for job in jobs:\n        path = sharddir / f"{job[\'id\']}.json"\n        if path.isfile():\n            existing[job["id"]] = validatepdeshard(job, json.loads(path.readtext(encoding="utf-8")))\n        else:\n            missing.append(job)\n\n    total, completed = len(jobs), len(existing)\n    print(f"[PDE] {\'resuming\' if completed else \'starting\'} {completed}/{total} durable board shards with {workers} workers", flush=True)\n    if workers == 1:\n        completedjobs = ((job, pdechunk(job)) for job in missing)\n        pool = None\n    else:\n        pool = ProcessPoolExecutor(maxworkers=workers)\n        futures = {pool.submit(pdechunk, job): job for job in missing}\n        completedjobs = ((futures[future], future.result()) for future in ascompleted(futures))\n    try:\n        for job, rows in completedjobs:\n            writeshard(sharddir / f"{job[\'id\']}.json", job, rows)\n            existing[job["id"]] = rows\n            completed += 1\n            print(f"[PDE] completed {completed}/{total}: {job[\'kind\']} board {job[\'boards\'][0]}", flush=True)\n    finally:\n        if pool is not None:\n            pool.shutdown(wait=True, cancelfutures=False)\n\n    if len(existing) != total:\n        raise RuntimeError(f"incomplete shard set: {total - len(existing)} missing")\n    return [row for job in jobs for row in existing[job["id"]]]\n\n\ndef evaluatechunks(jobs, workers):\n    total, completed = len(jobs), 0\n    print(f"[PDE] starting {total} board shards with {workers} workers", flush=True)\n    if workers == 1:\n        results = []\n        for job in jobs:\n            results.append(pdechunk(job))\n            completed += 1\n            print(f"[PDE] completed {completed}/{total}: {job[\'kind\']} board {job[\'boards\'][0]}", flush=True)\n        return results\n    with ProcessPoolExecutor(maxworkers=workers) as pool:\n        futures = {pool.submit(pdechunk, job): job for job in jobs}\n        results = []\n        for future in ascompleted(futures):\n            job = futures[future]\n            results.append(future.result())\n            completed += 1\n            print(f"[PDE] completed {completed}/{total}: {job[\'kind\']} board {job[\'boards\'][0]}", flush=True)\n        return results\n\n\ndef selected(rows, context, agent, opponent=None):\n    return [row for row in rows if row["context"] == context and row["agent"] == agent\n            and (opponent is None or row.get("opponent") == opponent)]\n\n\ndef comparison(rows, context, left, right, rotations, metric="activewin", opponent=None):\n    return pairedboardbootstrap(selected(rows, context, left, opponent),\n                                  selected(rows, context, right, opponent), metric, rotations,\n                                  resamples=BOOTSTRAPRESAMPLES, seed=BOOTSTRAPSEED)\n\n\ndef buildreport(rows):\n    summaries = {}\n    for context in ("E2", "E1", "D"):\n        for agent in sorted({row["agent"] for row in rows if row["context"] == context}):\n            key = f"{context}:{agent}"\n            summaries[key] = summarizerows(selected(rows, context, agent))\n    for opponent in ("G", "F", "S", "B", "legacyD"):\n        for agent in ("G", "Gsearch3"):\n            summaries[f"D:{opponent}:{agent}"] = summarizerows(selected(rows, "D", agent, opponent))\n    comparisons = {}\n    for context, rotations in (("E2", 4), ("E1", 3)):\n        for left, right in (("Gsearch3", "G"), ("G", "RB"), ("Gsearch3", "RB"), ("G", "legacyE")):\n            comparisons[f"{context}:{left}-minus-{right}"] = comparison(rows, context, left, right, rotations)\n    for opponent in ("G", "F", "S", "B", "legacyD"):\n        comparisons[f"D:{opponent}:Gsearch3-minus-G"] = comparison(rows, "D", "Gsearch3", "G", 2, opponent=opponent)\n\n    e2rulebot = comparisons["E2:G-minus-RB"]\n    dvalues = [comparisons[f"D:{opponent}:Gsearch3-minus-G"] for opponent in ("G", "F", "S", "B", "legacyD")]\n    # Proposal conditions are intentionally descriptive: active CI lower <= 0,\n    # G + search3 WR < 60%, or an opponent comparison\'s lower CI <= 0.\n    dwr = [summaries[f"D:{opponent}:Gsearch3"]["winrate"]\n            for opponent in ("G", "F", "S", "B", "legacyD")]\n    proposals = {\n        "phaseEfromG": e2rulebot["ci95lowerpp"] <= 0,\n        "phaseDfromG": any(item["ci95lowerpp"] <= 0 for item in dvalues) or any(value < 60.0 for value in dwr),\n        "decision": "proposalonlynotrainingstarted",\n    }\n    return {"scheduleE": SCHEDULEE, "maxsteps": MAXSTEPS, "records": rows,\n            "summary": summaries, "comparisons": comparisons, "proposals": proposals}\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(description="PDE Phase D/E frozen evaluator (no training)")\n    parser.addargument("--output", type=Path, default=ROOT / "runs/pde-50000")\n    parser.addargument("--workers", type=int, default=5, help="reserved evaluation worker count (normal protocol: 5)")\n    parser.addargument("--smoke", action="storetrue", help="short synthetic smoke; never opens seed 50000")\n    parser.addargument("--resume", action="storetrue", help="resume a registered interrupted run from validated board shards")\n    args = parser.parseargs(argv)\n    if SCHEDULEEVALUES != (SCHEDULEE["suddendeathstart"], SCHEDULEE["suddendeathinterval"],\n                             SCHEDULEE["suddendeathwarningsteps"]):\n        raise RuntimeError("Schedule E registration mismatch")\n    if args.workers < 1:\n        parser.error("--workers must be positive")\n    if args.output.exists() and not args.resume:\n        raise FileExistsError(f"Refusing to overwrite existing output: {args.output}")\n    prior = validateresume(args.output, smoke=args.smoke) if args.resume else None\n    required = [GPATH, FPATH, SPATH, BPATH, LEGACYDPATH, *LEGACYEPATHS.values()]\n    requirepaths(required)\n    currentsources = {name: sha256file(ROOT / name) for name in ("bombermanenv.py", "evaluate.py", "pdeeval.py", "runpdecheck.py")}\n    currentcheckpoints = {str(path.relativeto(ROOT)): digest(path) for path in required}\n    if prior and prior.get("sources") != currentsources:\n        raise ValueError("resume evaluator source misalignment with registered run")\n    if prior and prior.get("checkpoints") != currentcheckpoints:\n        raise ValueError("resume checkpoint misalignment with registered run")\n    if not args.smoke and not args.resume:\n        reserveexperimentseed(ROOT, "PDE", NORMALSEED, args.output)\n    args.output.mkdir(parents=True, existok=args.resume)\n    smoke = args.smoke\n    seed = prior["seed"] if prior else (90000 if smoke else NORMALSEED)\n    maxsteps = prior["maxsteps"] if prior else (2 if smoke else MAXSTEPS)\n    e2count, e1count, dcount = (1, 1, 1) if smoke else (40, 60, 100)\n    registration = {\n        "seed": seed, "normalseed": NORMALSEED, "smoke": smoke, "scheduleE": SCHEDULEE,\n        "maxsteps": maxsteps, "workers": args.workers,\n        "checkpoints": currentcheckpoints,\n        "sources": currentsources,\n        "python": sys.version, "platform": platform.platform(),\n    }\n    if not smoke and not args.resume:\n        (args.output / "testopened.json").writetext(json.dumps({"seed": NORMALSEED, "stage": "PDE"}, indent=2), encoding="utf-8")\n    if not args.resume:\n        (args.output / "registration.json").writetext(json.dumps(registration, indent=2), encoding="utf-8")\n    jobs = makejobs(seed, e2count, e1count, dcount, maxsteps)\n    rows = runshards(args.output, jobs, args.workers)\n    report = buildreport(rows)\n    (args.output / "report.json").writetext(json.dumps(report, indent=2), encoding="utf-8")\n    if not smoke:\n        shutil.makearchive(str(args.output) + "-send", "zip", args.output)\n    print(json.dumps({"output": str(args.output), "proposals": report["proposals"]}, indent=2))\n\n\nif name == "main":\n    main()\n'

