{
  "name": "bomberman-foundry-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "test:unit": "node --experimental-strip-types --test tests/client.test.ts",
    "test": "npm run test:unit && npm run test:browser"
  },
  "dependencies": {"phaser": "3.90.0"},
  "devDependencies": {"@playwright/test": "1.64.1", "typescript": "5.9.3", "vite": "8.3.5"}
}
